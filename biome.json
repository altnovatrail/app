{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "scripts/**", "walk/**", "*.ts", "*.json", "!package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": ["act"],
                "message": "Take act from @testing-library/react: it turns IS_REACT_ACT_ENVIRONMENT on for its own time, which the tests in the browser keep off (src/test/browser.setup.ts)."
              }
            }
          }
        }
      }
    }
  }
}
